+
+// THE REQUEST BETWEEN THE TWO CORNERS IS BLENDED LINEARLY IN THE LOGICAL
+// COORDINATE, which is not a choice — `src/MbQuality.cpp` measures the achieved
+// height against exactly that blend, and the smoother's control functions aim at
+// it for the same stated reason. Driving the fill at one measure while the ruler
+// reads another is the defect `.claude/rules/mesher-smoothing.md` names.
+double mbWallRequest(size_t k, size_t n, double reqLo, double reqHi) {
+    if (n < 2) return reqLo;
+    const double t = static_cast<double>(k) / static_cast<double>(n - 1);
+    return (1.0 - t) * reqLo + t * reqHi;
+}
