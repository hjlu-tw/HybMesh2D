+// subtracted term is the boolean sum's tensor part, and it is what makes this
+// vanish at `along` = 0 and 1 as well as at `across` = 0 and 1. Under variant 2
+// the two end deltas are already zero, so that term contributes nothing there.
+Point2D mbHermiteTerm(const std::vector<Point2D>& dLo,
+                      const std::vector<Point2D>& dHi,
+                      size_t k, double across, double along) {
