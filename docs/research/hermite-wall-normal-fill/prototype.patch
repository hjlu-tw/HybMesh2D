+// wall to the first interior grid line, which is what turns a requested LENGTH
+// into a derivative: `r(u) = wall + u·T + O(u²)`.
+std::vector<Point2D> mbHermiteDelta(const std::vector<Point2D>& lo,
+                                    const std::vector<Point2D>& hi,
+                                    bool atFarEnd, double gap,
+                                    double reqLo, double reqHi) {
+    const size_t n = lo.size();
+    std::vector<Point2D> d(n, Point2D{0.0, 0.0});
+    if (n < 2 || hi.size() != n || !(gap > 0.0)) return d;
+    const double sgn = atFarEnd ? -1.0 : 1.0;
+    const std::vector<Point2D> nrm = mbWallNormals(lo, hi, atFarEnd);
+    for (size_t k = 0; k < n; ++k) {
+        const double req = mbWallRequest(k, n, reqLo, reqHi);
+        if (!(req > 0.0) || nrm[k].lengthSq() == 0.0) continue;
+        d[k] = nrm[k] * (sgn * req / gap) - (hi[k] - lo[k]);
+    }
+    return d;
+}
+
+// VARIANT 2. The same cubic correction, calibrated against `step` — the vector
+// the fill ACTUALLY puts between the wall node and the first interior one — and
+// forced to zero at the two end stations. `weight` is the Hermite basis function
+// this end's delta is multiplied by AT that first interior line, so dividing by
+// it makes the correction land the node on `req * n̂` exactly, up to the other
+// end's own basis function there (which is O(gap²) and is why the two ends do
+// not have to be solved together).
+std::vector<Point2D> mbHermiteCalib(const std::vector<Point2D>& lo,
+                                    const std::vector<Point2D>& hi, bool atFarEnd,
+                                    const std::vector<Point2D>& step, double weight,
+                                    double reqLo, double reqHi) {
+    const size_t n = lo.size();
+    std::vector<Point2D> d(n, Point2D{0.0, 0.0});
+    if (n < 3 || hi.size() != n || step.size() != n || weight == 0.0) return d;
+    const std::vector<Point2D> nrm = mbWallNormals(lo, hi, atFarEnd);
+    for (size_t k = 1; k + 1 < n; ++k) {
+        const double req = mbWallRequest(k, n, reqLo, reqHi);
+        if (!(req > 0.0) || nrm[k].lengthSq() == 0.0) continue;
+        d[k] = (nrm[k] * req - step[k]) * (1.0 / weight);
+    }
+    return d;
+}
