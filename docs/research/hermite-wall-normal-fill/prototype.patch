+// direction this blend already moves in. A zero vector where there is no normal.
+std::vector<Point2D> mbWallNormals(const std::vector<Point2D>& lo,
+                                   const std::vector<Point2D>& hi, bool atFarEnd) {
+    const std::vector<Point2D>& wall = atFarEnd ? hi : lo;
+    const double sgn = atFarEnd ? -1.0 : 1.0;
+    const std::vector<Point2D> tang = mbWallTangents(wall);
+    std::vector<Point2D> nrm(tang.size(), Point2D{0.0, 0.0});
+    for (size_t k = 0; k < tang.size(); ++k) {
+        if (tang[k].lengthSq() == 0.0) continue;
+        Point2D v = tang[k].leftNormal();
+        if (v.dot((hi[k] - lo[k]) * sgn) < 0.0) v = v * -1.0;
+        nrm[k] = v;
+    }
+    return nrm;
