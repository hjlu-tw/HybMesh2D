{
  "pipeline_version": 2,
  "name": "ogrid_family_demo",
  "cads": [],
  "mesh": {
    "mesh_mode": 1,
    "geom_files": [
      "examples/geometries/circle_body.dat",
      "examples/geometries/circle_farfield.dat"
    ],
    "geom_roles": {
      "examples/geometries/circle_farfield.dat": {
        "role": "farfield"
      }
    },
    "topology": {
      "family": "ogrid",
      "ogrid_body_geom": "examples/geometries/circle_body.dat",
      "ogrid_body_segs": "0,1,2,3",
      "ogrid_far_geom": "examples/geometries/circle_farfield.dat",
      "ogrid_far_segs": "0,1,2,3",
      "ogrid_splits": 1,
      "ogrid_cell": 0.033,
      "ogrid_radial_count": 49
    },
    "mb_split_quads": true,
    "mb_split_rule": 0,
    "mb_split_seed": 0,
    "bl_initial_thickness": 0.001,
    "bc_geom": "wall",
    "export_vtk": true,
    "export_starcd": true,
    "output_filename": "results/meshes/ogrid_family_demo/mesh_ogrid_family_demo.vtk"
  },
  "solver": {
    "case_name": "ogrid_family_demo",
    "preset": "Laminar NS (subsonic, steady)",
    "flow_solu_type": "ns_sol",
    "turb_model_option": "laminar",
    "fs_mach": 0.2,
    "fs_flow_angle": 0.0,
    "fs_unit_re": 200.0,
    "fs_tinf": 288.0,
    "linf": 1.0,
    "gamma": 1.4,
    "prandtl": 0.72,
    "cfl": 0.6,
    "constant_cfl": true,
    "num_half_iter": 100,
    "print_convg_per_niter": 10,
    "print_sol_per_niter": 100,
    "dump_zone_per_niter": 100
  },
  "results": {
    "variable": "M",
    "cmap": "jet",
    "save_png": "results/pipeline/ogrid_family_demo_M.png",
    "mesh_overlay": false
  }
}
