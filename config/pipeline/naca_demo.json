{
  "pipeline_version": 1,
  "name": "naca_demo",
  "cad": {
    "input_file": "examples/geometries/naca0012.dat",
    "is_closed": true,
    "skip": true
  },
  "mesh": {
    "domain_x_min": -1.5,
    "domain_x_max": 2.5,
    "domain_y_min": -1.5,
