    "bc_ymin": "outlet",
    "bc_ymax": "outlet"
  },
  "solver": {
    "case_name": "naca_demo",
    "preset": "Euler (inviscid)",
    "fs_mach": 0.5,
    "fs_flow_angle": 2.0,
    "cfl": 0.5,
    "num_half_iter": 200,
    "print_convg_per_niter": 20,
    "print_sol_per_niter": 200,
    "dump_zone_per_niter": 200
  },
  "results": {
    "variable": "M",
