# ==============================================================================
# Multi-block structured meshing (MESH_MODE 1) — THE FIRST SHIPPED CASE WHOSE
# NODE COUNT FALLS GOING OUTWARD.
#
#   ./run.sh -conf config/multiblock_reducing.dat
#
# The same two circles as config/multiblock_ogrid.dat, and the comparison with
# that case is the point of shipping this one:
#
#                            ogrid        reducing
#   body intervals            96            192
#   far-field intervals       96             96
#   blocks                     4             36
#   worst non-orthogonality  2.025 deg     53.576 deg
#
# A COUNT CAN BE REDUCED ONLY BY A CORNER SHARED BY THREE BLOCKS — the one
# device in this model that ends a grid line — and the reduction is 2*K*a for K
# corner blocks of radial depth a, here 2 * 4 * 12 = 96. The angle is what it
# costs. The declaration explains itself at length in the topology file.
# ==============================================================================

MESH_MODE 1
MESH_TOPOLOGY_FILE examples/topology/reducing_ogrid.json

# The SHIPPED circles, the same pair the four-block O-grid uses, so the two
# cases differ in their blocking and in nothing else.
GEOM_FILE examples/geometries/circle_body.dat
DOMAIN_FILE examples/geometries/circle_farfield.dat nobl

BL_INITIAL_THICKNESS 0.001

MB_SPLIT_QUADS 1

# The FALLBACK. Every wall edge here binds, so nothing should reach it.
BC_GEOM wall

EXPORT_VTK 1
EXPORT_STARCD 1
OUTPUT_FILENAME results/meshes/multiblock_reducing/mesh_multiblock_reducing.vtk
